exports[`generated files > data > indexes > lazy-by-searchable > matches snapshot 1`] = `
"import type { GemfileLock } from "@/generated/data/languages/data/gemfile-lock";

import type { Language, Dictionary } from "@/generated/types/common/language-types.generated";

const lazy_by_searchable: LazyBySearchable = { "false": () => Promise.all([ import('@/generated/data/languages/data/gemfile-lock').then(({ gemfile_lock }) => gemfile_lock) ]), } as const;

type LazyBySearchable = { "false": () => Promise<readonly [GemfileLock]>, } &  Dictionary<() => Promise<readonly Language[] | undefined>>;

export { lazy_by_searchable };

export type { LazyBySearchable };"
`;

